# ===================================================================
# 遗留单体服务配置 - dev
# 本文件是历史遗留, 模块众多, 正在逐步拆分
# 维护群: #legacy-migration
# ===================================================================

# ---- 模块 1: 用户 ----
module.user:
  # 开发 mock 数据
  data-source: mock
  cache-ttl: 300
  # 批量大小
  batch-size: 10

# ---- 模块 2: 订单 ----
module.order:
  enabled: true
  # 超时(秒)
  timeout: 30
  # 重试
  retry: 3

# ---- 模块 3: 报表 ----
module.report:
  # 开发实时, 生产离线
  mode: realtime
  # 输出目录
  output: /var/report/dev

# legacy note 1: 模块1迁移进度 30% (2026-02)
# legacy note 2: 模块2迁移进度 30% (2026-03)
# legacy note 3: 模块3迁移进度 30% (2026-04)
# legacy note 4: 模块4迁移进度 30% (2026-05)
# legacy note 5: 模块5迁移进度 30% (2026-06)
# legacy note 6: 模块6迁移进度 30% (2026-07)
# legacy note 7: 模块7迁移进度 30% (2026-08)
# legacy note 8: 模块8迁移进度 30% (2026-09)
# legacy note 9: 模块9迁移进度 30% (2026-10)
# legacy note 10: 模块10迁移进度 30% (2026-11)

# ---- 模块 4: 消息 ----
module.message:
  queue: local
  depth: 100

# ---- 模块 5: 定时任务 ----
module.cron:
  # 开发只开一个
  jobs:
    - name: clean-dev
      schedule: '0 3 * * *'

# ---- 通用 ----
common:
  log-level: DEBUG
  # 监控 关闭
  metrics-enabled: false
  # tag 标记
  tag: A
