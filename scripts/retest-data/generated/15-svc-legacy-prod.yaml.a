# ---- 模块 4: 消息 ----
module.message:
  queue: rocketmq
  depth: 10000

# ---- 模块 5: 定时任务 ----
module.cron:
  # 开发只开一个
  jobs:
    - name: clean
      schedule: '0 3 * * *'
    - name: sync-external
      schedule: '0 */6 * * *'
    - name: archive
      schedule: '0 4 1 * *'

# ---- 通用 ----
common:
  log-level: INFO
  # 监控 开启
  metrics-enabled: true
  # tag 标记
  tag: A
