# ===================================================================
# 遗留单体服务配置 - prod
# 本文件是历史遗留, 模块众多, 正在逐步拆分
# 维护群: #legacy-migration
# ===================================================================

# ---- 模块 1: 用户 ----
module.user:
  # 开发 真实数据源
  data-source: db
  cache-ttl: 30
  # 批量大小
  batch-size: 500

# ---- 模块 2: 订单 ----
module.order:
  enabled: true
  # 超时(秒)
  timeout: 5
  # 重试
  retry: 1

# ---- 模块 3: 报表 ----
module.report:
  # 开发实时, 生产离线
  mode: batch
  # 输出目录
  output: /var/report/prod

