# 搜索服务 - 开发
app:
  name: search-svc
  # 环境标记
  env: dev

elasticsearch:
  # 开发单机
  nodes:
    - http://127.0.0.1:9200
  # 开发用默认索引
  index: search-dev
  # 开发不开 IK
  ik:
    enabled: false

# 召回策略
recall:
  # "true" 是字符串! 历史遗留, 下游按字符串处理
  fuzzy: "true"
  # 最小词元
  min-should-match: 3
  # 同义词
  synonyms:
    - phone -> mobile, cell
    - 电脑 -> computer

# 缓存
cache:
  # 开发用内存
  type: memory
  ttl-seconds: 60

# 排序
rank:
  # 开发只按相关度
  factors:
    - relevance
  # 不启用商业加权
  commercial-boost: false
