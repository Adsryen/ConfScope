# 订单服务 - 开发
# TOML 格式; ConfScope 当前按纯文本对比

[server]
# 开发端口
port = 8080
# 开发不开 TLS
tls = false

[order]
# 订单保留 30 天 (开发)
retention-days = 30
# 自动取消超时(分钟)
cancel-after-minutes = 1440
# 开发单实例
max-instances = 1

[db]
# 开发本机
dsn = "127.0.0.1:3306/order_dev"
# 连接池
pool-max = 10

# 开发特有的实验开关
[experiment]
new-pricing = true
# 实验组
cohort = "dev-all"
